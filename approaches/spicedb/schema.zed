definition user {}

definition org {
    relation admin: user
    relation editor: user
    relation viewer: user

    permission view_docs = viewer + editor + admin
    permission edit_docs = editor + admin
    permission delete_docs = admin
}

definition team {
    relation org: org
    relation member: user

    // Org roles apply only to documents of the user's own teams.
    permission view_docs = member & org->view_docs
    permission edit_docs = member & org->edit_docs
}

definition document {
    relation org: org
    relation team: team
    // Per-document shares.
    relation viewer: user
    relation editor: user

    permission view = org->admin + team->view_docs + viewer + editor
    permission edit = org->admin + team->edit_docs + editor
    permission delete = org->delete_docs
}
